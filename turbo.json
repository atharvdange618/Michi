{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "codegen": {
      "cache": false,
      "outputs": ["src/routeTree.gen.ts"]
    }
  }
}
