{
  "name": "michi-root",
  "private": true,
  "type": "module",
  "description": "A from-first-principles client-side router, built to learn how routers actually work under the hood.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "test": "turbo test",
    "codegen": "turbo codegen",
    "doctor": "npx react-doctor@latest",
    "lint": "oxlint -c .oxlintrc.json packages/michi/src apps/demo/src",
    "format": "oxfmt packages/michi/src apps/demo/src",
    "format:check": "oxfmt --check packages/michi/src apps/demo/src",
    "lint:fix": "oxlint -c .oxlintrc.json --fix packages/michi/src apps/demo/src",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "docs:dev": "blume dev",
    "docs:build": "blume build",
    "docs:preview": "blume preview",
    "preview": "astro preview"
  },
  "keywords": [
    "router",
    "client-side-routing",
    "react",
    "history-api",
    "typescript",
    "from-first-principles"
  ],
  "author": "Atharv Dange",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/atharvdange618/Michi"
  },
  "homepage": "https://github.com/atharvdange618/Michi#readme",
  "bugs": {
    "url": "https://github.com/atharvdange618/Michi/issues"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "turbo": "^2.9.17",
    "typescript": "~6.0.2"
  },
  "packageManager": "pnpm@11.13.0",
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint -c .oxlintrc.json --fix"
    ]
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.2",
    "@astrojs/react": "^6.0.1",
    "@shikijs/twoslash": "^4.3.1",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.7",
    "blume": "^1.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.2"
  }
}
